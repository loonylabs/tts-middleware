# TTS Middleware Configuration

# Microsoft Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=germanywestcentral
AZURE_SPEECH_ENDPOINT=https://germanywestcentral.tts.speech.microsoft.com

# EdenAI (multi-provider aggregator)
EDENAI_API_KEY=your_edenai_api_key_here

# Cartesia (Sonic – EU data residency by default, GDPR DPA, high quality)
CARTESIA_API_KEY=your_cartesia_api_key_here
# Optional API version pin (sent as Cartesia-Version header)
# CARTESIA_VERSION=2026-03-01
# Overridable provider defaults (applied when a request omits the value;
# always overridable per request via audio.speed / providerOptions).
# Recommended for narration: slightly slower + sentence/paragraph pauses.
# CARTESIA_DEFAULT_SPEED=0.9
# CARTESIA_DEFAULT_SENTENCE_PAUSE_MS=300
# CARTESIA_DEFAULT_PARAGRAPH_PAUSE_MS=700

# Default TTS Provider (azure, edenai, openai, elevenlabs, google, deepgram, fish_audio, inworld)
TTS_DEFAULT_PROVIDER=azure

# TTS Debug Mode (true/false)
TTS_DEBUG=false

# OpenAI (for future integration)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_TTS_MODEL=tts-1

# ElevenLabs (for future integration)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Cloud Text-to-Speech (DSGVO/GDPR compliant with EU endpoints)
# Path to your Service Account JSON file (standard Google env var)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account.json
# Google Cloud Project ID (optional - can be inferred from credentials)
GOOGLE_CLOUD_PROJECT=your_project_id
# Region for data residency - EU regions for DSGVO compliance
# Options: eu (recommended), europe-west1, europe-west2, europe-west3 (Frankfurt),
#          europe-west4, europe-west6, europe-west9, us-central1, global
GOOGLE_TTS_REGION=eu

# Fish Audio (test/admin only – no EU data residency)
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# Inworld AI (test/admin only – no EU data residency)
INWORLD_API_KEY=your_inworld_api_key_here

# Deepgram (for future integration)
# DEEPGRAM_API_KEY=your_deepgram_api_key_here
# DEEPGRAM_USE_EU_ENDPOINT=true

# Logging
LOG_LEVEL=info
NODE_ENV=development
